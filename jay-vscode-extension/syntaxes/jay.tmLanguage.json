{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Jay",
    "scopeName": "source.jay",
    "fileTypes": [
        "jay"
    ],
    "patterns": [
        {
            "match": "\\b(if|else|for|while|try|catch|return)\\b",
            "name": "keyword.control.jay"
        },
        {
            "match": "\\b(func|class|import|main)\\b",
            "name": "keyword.declaration.jay"
        },
        {
            "match": "\\b(int|float|string|bool|list|map|object)\\b",
            "name": "storage.type.jay"
        },
        {
            "match": "\\b(true|false|null)\\b",
            "name": "constant.language.jay"
        },
        {
            "match": "\\b(print|input|input_int|input_float|input_bool)\\b",
            "name": "support.function.builtin.jay"
        },
        {
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
            "name": "constant.numeric.jay"
        },
        {
            "begin": "\"",
            "end": "\"",
            "name": "string.quoted.double.jay"
        },
        {
            "match": "#.*$",
            "name": "comment.line.number-sign.jay"
        },
        {
            "begin": "/\\*",
            "end": "\\*/",
            "name": "comment.block.jay"
        },
        {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
            "captures": {
                "1": {
                    "name": "entity.name.function.jay"
                }
            }
        }
    ]
}